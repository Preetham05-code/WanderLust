<% layout("/layouts/boilerplate") %>
<script>
    const coordinates = <%- JSON.stringify(List.geometry.coordinates) %>;
    const listingTitle = "<%= List.title %>";
</script>
<body>

    <div class="row mt-3 mb-3">

        <div class="col-8 offset-2">
            <h3><%= List.title %></h3>
        </div>

        <div class="card col-6 offset-2 show-card listing-card">
            <img src="<%= List.image.url %>" class="card-img-top show-img" alt="listing_image">

            <div class="card-body">
                <p class="card-text">
                    Hosted by <i><%= List.owner.username %></i>
                    <br>

                    <%= List.description %>
                    <br><br>

                    &#8377 <%= List.price.toLocaleString("en-IN") %>
                    <br><br>

                    <%= List.location %>
                    <br>

                    <%= List.country %>
                    <br>
                </p>
            </div>
        </div>

    </div>

    <% if (currUser && List.owner._id.equals(currUser._id)) { %>

        <div class="btns col-1 d-flex gap-2 offset-2">

            <form method="GET" action="/listings/<%= List._id %>/edit">
                <button class="btn mb-2 edit-btn">Edit</button>
            </form>

            <form method="POST" action="/listings/<%= List._id %>?_method=DELETE">
                <button class="btn btn-dark">Delete</button>
            </form>

        </div>

    <% } %>

    <div class="col-8 offset-2">

        <hr>

        <% if (currUser) { %>

            <h4>Leave a Review</h4>

            <form action="/listings/<%= List._id %>/reviews"
                  method="POST"
                  novalidate
                  class="needs-validation">

                <div class="mb-3 mt-3">

                    <label class="form-label" for="rating">Rating</label>

                    <fieldset class="starability-slot">

                        <input type="radio"
                               id="no-rate"
                               class="input-no-rate"
                               name="review[rating]"
                               value="1"
                               checked
                               aria-label="No rating." />

                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>

                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>

                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>

                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>

                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>

                    </fieldset>

                </div>

                <div class="mb-3 mt-3">

                    <label class="form-label" for="comment">Comments</label>

                    <textarea
                        class="form-control"
                        name="review[comment]"
                        id="comment"
                        cols="40"
                        rows="5"
                        required></textarea>

                    <div class="invalid-feedback">
                        Please add some comments for review
                    </div>

                </div>

                <button class="btn btn-dark mb-3">Submit</button>

            </form>

        <% } %>

        <p><b>All Reviews</b></p>

        <div class="row">

            <% for (review of List.reviews) { %>

                <div class="card review-card col-5 ms-2 mb-3">

                    <div class="card-body">

                        <h5 class="card-title">
                            @<%= review.author.username %>
                        </h5>

                        <p class="card-text starability-result mb-2"
                           data-rating="<%= review.rating %>">
                        </p>

                        <p class="card-text mb-2">
                            <%= review.comment %>
                        </p>

                    </div>

                    <form
                        class="mb-3"
                        method="POST"
                        action="/listings/<%= List._id %>/reviews/<%= review._id %>?_method=DELETE">

                        <button class="btn btn-sm btn-dark">
                            Delete
                        </button>
                    </form>
                </div>
            <% } %>
        </div>
    </div>
    
    <div class="col-8 offset-2 mb-3">
        <h3>Where you will be</h3>
        <div id="map"></div>
    </div>

<script src="/js/map.js"></script>
</body>